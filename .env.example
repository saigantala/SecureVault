# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/securevault

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_at_least_64_random_bytes

# ─── WalletConnect (get at https://cloud.walletconnect.com) ──────────────────
NEXT_PUBLIC_WALLETCONNECT_ID=your_walletconnect_project_id

# ─── S3-compatible Object Storage ────────────────────────────────────────────
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.
S3_ENDPOINT=https://s3.amazonaws.com         # or https://<accountid>.r2.cloudflarestorage.com
S3_REGION=us-east-1
S3_BUCKET=securevault-files
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# ─── Email Alerts (SMTP — for anomaly detection) ─────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_smtp_password
ALERT_FROM_EMAIL=no-reply@yourdomain.com

# ─── App URL (used for cookie domain / SIWE URI) ─────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: On-chain hash anchoring (Polygon / any EVM L2) ────────────────
# ANCHOR_RPC_URL=https://polygon-rpc.com
# ANCHOR_PRIVATE_KEY=0x...
# ANCHOR_CONTRACT_ADDRESS=0x...
